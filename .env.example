# ============================================================
# Variáveis de ambiente SERVER-SIDE (Vercel) — api/admin/create-user
# ============================================================
# Cadastrar em: Vercel → Project Settings → Environment Variables.
# NUNCA usar o prefixo VITE_ nestas — variáveis VITE_* são embutidas no
# bundle do navegador pelo Vite e ficariam públicas.
#
# Nunca commitar este arquivo com valores reais preenchidos — ele existe
# só para documentar os NOMES esperados (.env real já está no
# .gitignore).

# Credenciais da conta de serviço do Firebase Admin (Firebase Console →
# Configurações do projeto → Contas de serviço → Gerar nova chave privada).
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Cole a private key exatamente como veio do JSON da conta de serviço —
# o código já trata o caso de \n literal (linha única) automaticamente.
FIREBASE_ADMIN_PRIVATE_KEY=

# Mesmo e-mail já usado em src/firebase.ts (BOOTSTRAP_ADMIN_EMAIL) e em
# firestore.rules (isAdmin()) — precisa ser idêntico nos três lugares.
BOOTSTRAP_ADMIN_EMAIL=
